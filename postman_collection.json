{
  "info": {
    "name": "Twoly API - Example Collection",
    "_postman_id": "twoly-example-collection",
    "description": "Collection with example requests for Twoly API (use {{baseUrl}} and {{token}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "memoryId", "value": "" },
    { "key": "photoId", "value": "" },
    { "key": "datePlanId", "value": "" },
    { "key": "checklistId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "loveNoteId", "value": "" },
    { "key": "inviteCode", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "coupleId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"username\": \"alice123\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_or_username\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login status is success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.access_token) {",
                  "  pm.collectionVariables.set('token', jsonData.data.access_token);",
                  "}",
                  "",
                  "if (jsonData && jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
                  "  pm.collectionVariables.set('userId', jsonData.data.user.id);",
                  "}"
                ]
              }
            }
          ]
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Update Profile (JSON)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated\",\n  \"username\": \"alice_new\",\n  \"avatar_url\": \"https://example.com/avatar.jpg\"\n}"
            }
          }
        },
        {
          "name": "Update Profile (Upload Avatar)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "type": "text", "value": "Alice Updated" },
                { "key": "username", "type": "text", "value": "alice_new" },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": "<path-to-avatar-file>"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Couples",
      "item": [
        {
          "name": "Create Invite",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/couples/invite",
              "host": ["{{baseUrl}}"],
              "path": ["couples", "invite"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"anniversary_date\": \"2026-06-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData?.data?.invite_code) pm.collectionVariables.set('inviteCode', jsonData.data.invite_code);",
                  "if (jsonData?.data?.couple_id) pm.collectionVariables.set('coupleId', jsonData.data.couple_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Join Couple",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/couples/join",
              "host": ["{{baseUrl}}"],
              "path": ["couples", "join"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_code\": \"{{inviteCode}}\"\n}"
            }
          }
        },
        {
          "name": "Get My Couple",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/couples/me",
              "host": ["{{baseUrl}}"],
              "path": ["couples", "me"]
            }
          }
        },
        {
          "name": "Update Couple Settings",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/couples/me",
              "host": ["{{baseUrl}}"],
              "path": ["couples", "me"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"anniversary_date\": \"2026-06-01\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Memories",
      "item": [
        {
          "name": "Create Memory",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/memories",
              "host": ["{{baseUrl}}"],
              "path": ["memories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Beach day\",\n  \"description\": \"Sunset with partner\",\n  \"memory_date\": \"2026-05-15\",\n  \"location_name\": \"Kuta Beach\",\n  \"latitude\": 12.34,\n  \"longitude\": 56.78,\n  \"mood\": \"happy\",\n  \"tags\": [\"vacation\",\"sunset\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData?.data?.id) pm.collectionVariables.set('memoryId', jsonData.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Memories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/memories?month=2026-05",
              "host": ["{{baseUrl}}"],
              "path": ["memories"],
              "query": [{ "key": "month", "value": "2026-05" }]
            }
          }
        },
        {
          "name": "Get Memory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/memories/{{memoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["memories", "{{memoryId}}"]
