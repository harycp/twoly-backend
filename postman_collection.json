          }
        },
        {
          "name": "Update Memory",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/memories/{{memoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["memories", "{{memoryId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"description\": \"Updated description\",\n  \"memory_date\": \"2026-05-16\",\n  \"location_name\": \"Seminyak Beach\",\n  \"latitude\": 12.35,\n  \"longitude\": 56.79,\n  \"mood\": \"excited\",\n  \"tags\": [\"vacation\", \"sunset\", \"updated\"]\n}"
            }
          }
        },
        {
          "name": "Delete Memory",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/memories/{{memoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["memories", "{{memoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Memory Photos",
      "item": [
        {
          "name": "Upload Photos",
