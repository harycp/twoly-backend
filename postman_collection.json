                { "key": "files", "type": "file", "src": "<path-to-file1>" },
                { "key": "files", "type": "file", "src": "<path-to-file2>" },
                { "key": "captions", "type": "text", "value": "First photo" },
                { "key": "captions", "type": "text", "value": "Second photo" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (Array.isArray(jsonData?.data) && jsonData.data.length > 0 && jsonData.data[0]?.id) {",
                  "  pm.collectionVariables.set('photoId', jsonData.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Photos",
          "request": {
